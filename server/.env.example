# Claude API（通过小米 MiMo 代理）
ANTHROPIC_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
ANTHROPIC_AUTH_TOKEN=your-api-key
ANTHROPIC_MODEL=mimo-v2.5-pro

# MiMo TTS（可选，默认使用 ANTHROPIC_AUTH_TOKEN）
MIMO_TTS_API_KEY=your-api-key

# 网易云登录 cookie（通过 netease-login 脚本获取）
# NETEASE_COOKIE_FILE=./data/netease-cookie.txt

# SQLite 数据库路径（相对于 server/ 目录）
DB_PATH=./data/radio.db

# 位置（用于天气）
LATITUDE=31.23
LONGITUDE=121.47

# 服务端口
PORT=15620
